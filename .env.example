# ── Required ──────────────────────────────────────────────────────────────────
# Twitch application credentials (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Bot account OAuth tokens
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

# Twitch login name of the bot account
TWITCH_BOT_USERNAME=

# ── Optional: server ──────────────────────────────────────────────────────────
# Host defaults to 127.0.0.1 (localhost only — the overlay endpoints have no
# auth). Set 0.0.0.0 to expose the server on all interfaces, e.g. in Docker.
VIZER_SERVER_HOST=127.0.0.1
VIZER_SERVER_PORT=8080

# ── Optional: token persistence ───────────────────────────────────────────────
# Where twitchio stores refreshed OAuth tokens (default: .tio.tokens.json in
# the working directory). The Docker image sets this to /data/.tio.tokens.json
# so tokens survive container redeploys via the mounted ./data volume.
#VIZER_TOKEN_FILE=.tio.tokens.json

# ── Optional: logging ─────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
VIZER_LOG_LEVEL=INFO
