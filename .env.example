# ── Required ──────────────────────────────────────────────────────────────────
# Twitch application credentials (https://dev.twitch.tv/console/apps).
# The application must have http://localhost:4343/oauth/callback registered
# as an OAuth redirect URL — the first run opens a browser authorization flow
# and Twitch redirects back to that exact URL.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Removed variables ─────────────────────────────────────────────────────────
# TWITCH_ACCESS_TOKEN and TWITCH_REFRESH_TOKEN no longer exist: tokens are
# obtained by authorizing in the browser on first start and are persisted to
# VIZER_TOKEN_FILE from then on.
# TWITCH_BOT_USERNAME is no longer required; leave it unset on new installs.
# It is read only as a tie-breaker when a token file created by an older
# version holds tokens for several users.
#TWITCH_BOT_USERNAME=

# ── Optional: server ──────────────────────────────────────────────────────────
# Host defaults to 127.0.0.1 (localhost only — the overlay endpoints have no
# auth). Set 0.0.0.0 to expose the server on all interfaces, e.g. in Docker.
VIZER_SERVER_HOST=127.0.0.1
VIZER_SERVER_PORT=8080

# ── Optional: OAuth callback server ───────────────────────────────────────────
# Where the twitchio web adapter listens for the browser OAuth redirect.
# Defaults: localhost:4343. Docker sets VIZER_OAUTH_HOST=0.0.0.0 so the
# callback is reachable through the container port mapping. Changing the port
# changes the redirect URL you must register in the Twitch developer console.
#VIZER_OAUTH_HOST=localhost
#VIZER_OAUTH_PORT=4343
# Full redirect URL registered in the Twitch developer console. Defaults to
# http://localhost:<VIZER_OAUTH_PORT>/oauth/callback. Override it when the
# callback is exposed through a domain or reverse proxy (https required for
# non-localhost); the path must stay /oauth/callback.
#OAUTH_REDIRECT_URL=http://localhost:4343/oauth/callback

# ── Optional: token persistence ───────────────────────────────────────────────
# Where twitchio stores OAuth tokens (default: .tio.tokens.json in the
# working directory). A sidecar file <token file>.bot_id remembers which
# entry belongs to the bot account. The Docker image sets this to
# /data/.tio.tokens.json so tokens survive container redeploys via the
# mounted ./data volume.
#VIZER_TOKEN_FILE=.tio.tokens.json

# ── Optional: logging ─────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
VIZER_LOG_LEVEL=INFO
